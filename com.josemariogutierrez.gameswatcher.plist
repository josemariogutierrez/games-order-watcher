<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.josemariogutierrez.gameswatcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/josegutierrez/Personal Projects/smile-games-watcher/run-local.sh</string>
    </array>

    <!-- Every 5 minutes. watcher.py itself exits immediately outside the
         10:30-21:30 Bogota window, so no calendar rules are needed here.
         After sleep, launchd runs the missed job once on wake. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/josegutierrez/Personal Projects/smile-games-watcher</string>

    <key>StandardOutPath</key>
    <string>/Users/josegutierrez/Library/Logs/games-watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/josegutierrez/Library/Logs/games-watcher.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
